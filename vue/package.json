  "license": "UNLICENSED",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "test:e2e": "cypress run --spec 'cypress/e2e/**/*.cy.js'",
    "test:email-capture": "cypress run --spec 'cypress/e2e/email-capture.cy.js'",
    "test:exit-intent": "cypress run --spec 'cypress/e2e/exit-intent.cy.js'"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@popperjs/core": "^2.11.8",
    "@tabler/icons-vue": "^3.35.0",
    "@vueform/vueform": "^1.12.7",
    "axios": "^1.4.0",
    "bootstrap": "^5.3.2",
    "core-js": "^3.0.0",
    "element-plus": "^2.3.14",
    "js-cookie": "^3.0.5",
    "markdown-it": "^14.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-multimd-table": "^4.2.3",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "uuidv7": "^1.0.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.2.13",
    "vue-i18n": "11",
    "vue-router": "^4.0.0",
    "vue-turnstile": "^1.0.8",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@cypress/vue": "^6.0.2",
    "@cypress/webpack-dev-server": "^5.1.3",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/compiler-sfc": "^3.3.4",
    "@vue/language-plugin-pug": "^2.0.19",
    "cypress": "^15.5.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "pug": "^3.0.2",
    "pug-plain-loader": "^1.1.0",
    "sass": "^1.88.0",
    "sass-loader": "~16.0.5",
    "vue-eslint-parser": "^10.0.0",
    "webpack-manifest-plugin": "^5.0.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/valid-attribute-name": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
